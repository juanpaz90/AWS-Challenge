      "Bash(kubectl apply *)",
      "Bash(kubectl create *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl replace *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl autoscale *)",
      "Bash(kubectl rollout *)",
      "Bash(kubectl set *)",
      "Bash(kubectl label *)",
      "Bash(kubectl annotate *)",
      "Bash(kubectl taint *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl uncordon *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl run *)",
      "Bash(kubectl expose *)",
      "Bash(kubectl cp *)",
      "Bash(kubectl port-forward *)",
      "Bash(kubectl * apply *)",
      "Bash(kubectl * create *)",
      "Bash(kubectl * delete *)",
      "Bash(kubectl * edit *)",
      "Bash(kubectl * patch *)",
      "Bash(kubectl * replace *)",
      "Bash(kubectl * scale *)",
      "Bash(kubectl * rollout *)",
      "Bash(kubectl * set *)",
      "Bash(kubectl * label *)",
      "Bash(kubectl * annotate *)",
      "Bash(kubectl * drain *)",
      "Bash(kubectl * exec *)",
      "Bash(kubectl * run *)",

      "Bash(kind create *)",
      "Bash(kind delete *)",
      "Bash(task up*)",
      "Bash(task down*)",
      "Bash(task build*)",
      "Bash(task cluster:*)",
      "Bash(task aws:*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.kube/config)",
      "Read(**/.env)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Bash(aws configure*)",
      "Bash(aws sso *)",
      "Bash(aws sts *)",
      "Bash(eksctl create *)",
      "Bash(eksctl delete *)"
    ]
  },
  "enabledMcpjsonServers": ["terraform"]
}
