      "Bash(terraform init*)",
      "Bash(terraform plan*)",
      "Bash(terraform show*)",
      "Bash(terraform output*)",
      "Bash(terraform providers*)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)",
      "Bash(terraform -chdir=* fmt*)",
      "Bash(terraform -chdir=* validate*)",
      "Bash(terraform -chdir=* init*)",
      "Bash(terraform -chdir=* plan*)",
      "Bash(terraform -chdir=* show*)",
      "Bash(terraform -chdir=* output*)",
      "Bash(terraform -chdir=* providers*)",
      "Bash(terraform -chdir=* state list*)",
      "Bash(terraform -chdir=* state show*)",
      "Bash(terraform-docs *)",
      "Bash(tflint*)",
      "Bash(trivy *)",
      "Bash(checkov *)",
      "Bash(infracost breakdown*)",

      "Bash(hadolint *)",
      "Bash(yamllint *)",
      "Bash(kubeconform *)",
      "Bash(pre-commit run*)",
      "Bash(task lint*)",
      "Bash(task --list*)",
      "Bash(scripts/validate-helm.sh*)",

      "Bash(helm version*)",
      "Bash(helm lint *)",
      "Bash(helm template *)",
      "Bash(helm show *)",
      "Bash(helm list*)",
      "Bash(helm status *)",
      "Bash(helm history *)",
      "Bash(helm get *)",
      "Bash(helm search *)",
      "Bash(helm dependency *)",
      "Bash(helm-docs*)",

      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl api-resources*)",
      "Bash(kubectl version*)",
