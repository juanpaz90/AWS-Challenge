output "namespace" {
  description = "Namespace of the API and database."
  value       = kubernetes_namespace_v1.notes.metadata[0].name
}

output "database" {
  description = "Database cluster name, credentials Secret (generated by CNPG) and read-write Service."
  value = {
    cluster      = var.database.name
    secret       = "${var.database.name}-app"
    rw_service   = "${var.database.name}-rw"
    pod_selector = local.db_selector
  }
}

output "api_release" {
  description = "Helm release name and revision of the Notes API."
  value = {
    name     = helm_release.api.name
    revision = helm_release.api.metadata.revision
    image    = var.api.image.digest != "" ? "${var.api.image.repository}@${var.api.image.digest}" : "${var.api.image.repository}:${var.api.image.tag}"
  }
}
